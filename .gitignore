# Entorno virtual — se reconstruye desde uv.lock
.venv/
__pycache__/
*.py[cod]

# Secretos — jamás al repo
.env

# Datos — el repo guarda código, no datos
data/
exploration/output/
*.parquet
*.csv
*.duckdb
*.duckdb.wal

# La excepcion: el registro de cadencia SI se versiona. No es un dato extraido
# sino una medicion, pesa unos bytes por dia, y es lo unico del proyecto que no
# se recupera hacia atras: un dia que nadie miro es un dia perdido, porque la
# fuente sobrescribe.
#
# La regla general `*.csv` se lo tragaba en silencio. `git add -A` lo saltaba,
# los commits salian bien, y el sondeo programado se rompio en CI con un
# FileNotFoundError porque el archivo nunca habia llegado al repositorio.
!exploration/cadencia.csv

# dbt
target/
dbt_packages/
logs/

# Herramientas
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Sistema operativo / editor
.DS_Store
.vscode/
.idea/
datos/
*.jsonl.gz

dbt/target/
dbt/logs/
dbt/dbt_packages/
datos/secop.duckdb

.secretos/
dbt/.user.yml

# Airflow: su configuracion, su base de metadatos y sus logs. El DAG SI va a
# git, en dags/; lo que se ignora es el estado de la instalacion, que es local
# y se puede borrar entera para empezar de cero.
.airflow/
